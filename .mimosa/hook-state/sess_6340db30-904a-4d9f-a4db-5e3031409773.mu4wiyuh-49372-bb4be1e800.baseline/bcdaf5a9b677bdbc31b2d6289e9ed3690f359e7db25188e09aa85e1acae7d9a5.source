#!/usr/bin/env python3
"""v4.1：把 >100 字的 definition 精简到 ≤100 字（新教学规范）"""
import json

D = {
"0-2": "让脚本长成能上线的服务：用虚拟环境（venv，项目独立的包仓库）隔离依赖，用 async/await 异步重叠等待时间，用超时加重试扛住网络抖动，再用 Git 和测试守住协作底线。",
"0-5": "LLM（大语言模型）是读完海量互联网文本、用超级算力训练出的『文字接龙机器』：给它开头，它按学到的语言规律预测下一个词，接下去就成了回答、代码甚至推理。",
"0-5c": "SFT 只教了「怎么答」，没教「哪种答更得体」。RLHF 先用人类对回答的排序训出「打分器」（奖励模型），再让模型照分数自我优化；DPO 是简化版：直接用偏好数据优化，省掉打分器。",
"1-1": "Transformer 三拼：Encoder-only（BERT，会读）、Decoder-only（GPT，会写）、Enc-Dec（T5，先懂后写）。主流大模型几乎全是 Decoder-only。",
"1-1c": "调 LLM API 的工程四件套：采样参数（temperature/top_p）、流式输出（SSE 逐字降延迟）、限流与重试（429 退避、超时降级）、成本核算（按 token 计费、缓存省钱）。",
"1-2": "思维链（CoT）是让模型『一步步写出推理过程再给答案』：中间步骤给模型更多计算空间，复杂问题准确率显著提升。进阶变体：Self-Consistency 多路投票、ToT 树状探索。",
"1-3": "让模型稳定输出程序可解析的 JSON，靠三道关：提示词给 Schema 与示例 → API 的 JSON/严格模式 → 代码校验带错重试。这是把『聊天』变成『接口』的关键一步。",
"1-4c": "RAG 答不准，八成先怪检索。三大抓手：切分（大小合适、带元数据的块）、混合检索（向量+BM25 互补）、重排（Rerank 二次精排）——共同决定该找的资料有没有进提示词。",
"1-6": "LLM 输出不确定，改版好坏不能靠感觉。基本功：建金标集（20-200 条测试用例），每次改动跑一遍看分数；主观维度用 LLM-as-Judge 当裁判，但裁判有偏差，必须人工抽检校准。",
"1-7": "Demo 与生产之间隔着四座山：安全（注入/内容/PII）、权限（谁能调什么）、成本（按 token 计费、账单会失控）、延迟（用户对等待零容忍）。面试问「上过生产吗」，考的就是这四件事。",
"2-1": "AI Agent = 以 LLM 为大脑的智能体：外加任务清单（规划）、笔记本（记忆）、门禁卡（工具）三件套，能自己拆目标、调工具干活。Chatbot 只动嘴，Agent 能动手。",
"2-2": "规划（Planning）＝把模糊目标拆成带依赖的可执行子任务。主流做法：Plan-and-Execute 先计划后执行、ReWOO 一次规划批量并行省 token，失败后回炉重规划。",
"2-3b": "MCP 是模型连接工具/数据源的开放标准：工具方实现一次 MCP Server，任何支持 MCP 的客户端即插即用——把 M×N 套私有集成变成 M+N，被称为 AI 应用的 USB-C。",
"2-8": "多 Agent 协作＝把任务交给一支『AI 团队』：主管拆活分任务，工人分头干，靠结构化消息（格式固定的『工单』）通信，最后由评审把关。",
"2-9b": "Agent 评测难在多步：评轨迹（工具选对没）+评闭环（业务解决率）+评回归（golden set）。治理体系把评测制度化：Trace 回放、灰度发布、成本护栏——demo 到产品的最后一公里。",
"3-1": "Agent 上生产的第一步是分层：接入（鉴权限流）→AI 网关（路由/护栏/成本）→编排（Agent 循环）→数据（RAG/记忆/工具）→可观测（trace 指标）。每层都要答得出「删掉它会坏什么」。",
"3-2b": "合成数据是用模型生成训练数据再喂给模型的前沿：self-instruct 自举、强模型蒸馏、自博弈与 R1 式可验证数据——数据瓶颈时代的『用 AI 造 AI 粮食』。",
"3-3": "编排框架管 Agent 的状态与流程：LangGraph 图状态机、Agents SDK 轻量原语、LlamaIndex 数据索引；MCP 统一工具接入。口诀：复杂流程用图、知识密集看 Llama。",
"3-4": "LLM 可观测性＝给『不确定的输出』装仪表盘：全链路追踪（输入/输出/token/延迟/成本）、质量指标（拒绝率/幻觉抽样）、回归与 A/B。没有可观测性，调优全靠猜。",
"3-5": "1.6 教你跑一次评估，本页把评估变成体系：评估集分层（冒烟/回归/坏例库）、Judge 定期对人评校准、改动走单变量 A/B、跑分沉淀历史表——改版好坏永远有据可查。",
"3-6": "推理框架把 KV Cache 管理、连续批处理打包成开箱即用的引擎：vLLM 吞吐王者（生态最全）、TensorRT-LLM 极致延迟、llama.cpp 边缘端。选型三问：延迟、吞吐、部署环境。",
"3-6b": "推理显存三笔账：权重（参数量×每参数字节）+KV Cache（随并发与上下文线性涨）+激活与框架开销（约 10~20%）。失分点是只算权重漏算 KV；再叠加吞吐延迟要求算出单卡并发。",
"3-6c": "端侧推理＝把 LLM 跑在手机、PC、车载 NPU 上：低延迟、离线可用、数据不出设备，但受限于内存与功耗。NPU 算力军备赛与小模型+量化双轮驱动，生态成型中（趋势观察）。",
"3-7b": "KV Cache 把历史 token 的 K/V 缓存下来，每步生成免重算注意力——以显存换速度；PagedAttention（vLLM）借鉴操作系统分页，切块按需分配、消灭碎片，吞吐提升数倍。",
"3-7c": "LLM 降本三板斧：缓存（相同/相似请求不重算：前缀缓存、语义缓存）、模型路由（简单任务小模型）、批处理与压缩（Batch API 半价、上下文压缩）。组合拳通常省 50~80%。",
"3-8": "Agent 能读私有数据、执行代码、改外部系统，安全模型必须从「防说错话」升级为「防做错事」：按任务动态最小授权、任务结束权限衰减、高危操作人审、PII 脱敏、全链路留痕。",
"4-10": "作品集是工程能力的证明文件：架构图、指标表、可演示 Demo、复盘文档四件套，外加 STAR 讲项目故事。面试官不信形容词，只信可验证的证据链与诚实的取舍分析。",
"4-10b": "STAR＝情境（Situation）-任务（Task）-行动（Action）-结果（Result）。项目深挖的本质是验证据链：追问『数字怎么来的』就是在敲墙——每句结论都踩在可复现的证据上。",
"4-3": "数据分析 Agent 让用户用自然语言查数、画图、做解读：把问题翻译成 SQL/Python，在隔离沙箱中执行，再把结果讲成人话。核心矛盾「能力越强越危险」：只读账号+白名单+沙箱缺一不可。",
"4-4": "计算机使用 Agent（CUA）让 AI 像人一样操作图形界面：看屏幕（截图或页面结构）→决定点哪→动手→再看结果。感知-行动循环里每步都可能偏一点，步级错误累积是核心瓶颈。",
"4-5": "工作流自动化 Agent 按固定流程替人执行业务动作：发邮件、建工单、同步数据。企业敢用的前提是三大支柱——幂等（重复请求不重复执行）、人审闸门（高危先挂起等批准）、审计日志。",
"4-7b": "Agent 系统设计题（如『设计智能客服 Agent』）考察：单体架构四件套、编排模式选择、工具与权限治理、可靠性与评测、生产治理。答题主线：目标→架构→风险→闭环。",
"4-8": "功能评估证明 Agent『会干活』，安全评估才证明『不被使坏』。红队把 OWASP 双 Top10 变成攻击用例，用 Promptfoo、DeepTeam 自动化扫描，发现即修复并回归。",
"4-9": "Agent 上线后最常见的问题不是报错崩溃，而是『软故障』：不报错，但跑偏、卡死或质量悄悄变差。运维靠四层防御（护栏→熔断→抽检→回放定位）+黄金信号监控+告警止损。",
"h1-test-time-scaling": "测试时扩展＝回答问题时给模型更多『思考算力』：推理模型（DeepSeek-R1、o 系列）先生成长思维链再给答案——思考越久越准，用推理成本换准确率。",
"h2-rlvr-grpo": "对齐的最新演进：RLVR 用『可验证奖励』（对错程序判定）替代人类偏好；GRPO 用组内相对优势替代 PPO 的价值模型。两者合流催生 DeepSeek-R1 式推理模型。",
"h3-context-engineering-practice": "Context Engineering（上下文工程）是取代『提示词工程』的体系化学科：管理模型每一步『看见什么』——压缩、记忆工具、子代理隔离、按需检索，是长任务 Agent 的生命线。",
"h4-agentic-rag": "Agentic RAG 让 Agent 接管检索决策：自己判断要不要查、查什么、查几轮、结果够不够——把固定 RAG 流水线升级为会规划-检索-反思的自主智能体。RAG 演进主线。",
"h6-ai-coding-agents": "AI Coding 智能体＝自主操作代码库的开发 Agent：读仓库、改多文件、跑测试、自我修错、提交 PR（Claude Code/Cursor 类）。2026 最热产品形态与最佳教科书。",
"h8-agent-sandbox-reliability": "让 Agent 敢执行代码的前提是隔离：沙箱（容器/微 VM）把每个动作关进一次性环境——坏了就销毁、逃不出去、可复现。是 Agent 从『建议者』变成『执行者』的安全基石（趋势观察）。",
}

over = []
for pid, text in D.items():
    p = f"data/content/{pid}.json"
    d = json.load(open(p, encoding="utf-8"))
    if len(text) > 100:
        over.append((pid, len(text)))
    d["definition"] = text
    json.dump(d, open(p, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print("trimmed", len(D), "| still over:", over)
